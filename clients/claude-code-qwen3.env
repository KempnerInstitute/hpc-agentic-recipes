# Source this, then run `claude`, to point Claude Code at Qwen3-235B-A22B (full RTX node, TP8).
# Node and port come from scripts/config.sh; the API key comes from secrets/vllm_api_key.
_REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$_REPO/scripts/config.sh" 2>/dev/null || true
export ANTHROPIC_BASE_URL="http://${QWEN3_NODE}:${API_PORT}"
export ANTHROPIC_AUTH_TOKEN="$(cat "$_REPO/secrets/vllm_api_key" 2>/dev/null)"
export ANTHROPIC_MODEL=qwen3-235b
export ANTHROPIC_SMALL_FAST_MODEL=qwen3-235b
