# Source this, then run `claude`, to point Claude Code at Kimi-K2.7-Code (RTX PRO 6000).
# Node and port come from scripts/config.sh; the API key comes from secrets/vllm_api_key.
_REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$_REPO/scripts/config.sh" 2>/dev/null || true
export ANTHROPIC_BASE_URL="http://${KIMI_NODE}:${API_PORT}"
export ANTHROPIC_API_KEY="$(cat "$_REPO/secrets/vllm_api_key" 2>/dev/null)"
export ANTHROPIC_MODEL=kimi-k2.7-code
export ANTHROPIC_SMALL_FAST_MODEL=kimi-k2.7-code
