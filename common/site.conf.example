# Optional local overrides. Copy to common/site.conf, which is gitignored.
#
# You do not need this file. common/defaults.sh already carries working cluster values, so a fresh
# clone runs as is. This exists for two things that have no correct default in a shared repo: your
# Slurm account, and the names of nodes you already hold.

# Your Slurm account. Alternatively pass --account to sbatch at submit time.
# ACCOUNT=your_account

# Nodes you already hold, for the direct SSH launch path. The sbatch path needs none of these,
# because Slurm picks the node.
# GLM46_NODE=
# GLM52_NODE=
# GLM52_HEAD=
# GLM52_WORKER=
# KIMI_NODE=
# KIMI_HEAD=
# KIMI_WORKER=
# QWEN3_NODE=
# CODER_NODE=
# GEMMA_NODE=
# DEEPSEEK_HEAD=
# DEEPSEEK_WORKER=

# Override where environments are built or checkpoints are read from.
# ENV_ROOT=/n/netscratch/<lab>/<user>/agentic-coding-llm-env
# MODELS_DIR=/n/netscratch/<lab>/<user>/models
