# Optional local overrides. Copy to common/site.conf, which is gitignored.
#
# You do not need this file. common/defaults.sh already carries working cluster values, so a fresh
# clone runs as is. This exists for one thing that has no correct default in a shared repo: the names
# of nodes you already hold. Your Slurm account is not set here; pass --account to sbatch instead.

# Nodes you already hold, for the direct SSH launch path. The sbatch path needs none of these,
# because Slurm picks the node. One variable per recipe, since each hardware variant is separate.
# GLM46_NODE=           # GLM-4.6-FP8/h200-4
# GLM52_HEAD=           # GLM-5.2-FP8/h200-4-nodes2
# GLM52_WORKER=         # GLM-5.2-FP8/h200-4-nodes2
# GLM52_NVFP4_NODE=     # GLM-5.2-NVFP4/rtx-8
# KIMI_HEAD=            # Kimi-K2.7-Code/h200-4-nodes2
# KIMI_WORKER=          # Kimi-K2.7-Code/h200-4-nodes2
# KIMI_RTX_NODE=        # Kimi-K2.7-Code/rtx-8
# QWEN3_235B_NODE=      # Qwen3-235B-A22B/rtx-8
# QWEN3_CODER_NODE=     # Qwen3-Coder-480B-A35B-Instruct-FP8/rtx-8
# GEMMA26_H100_NODE=    # gemma-4-26B-A4B-it/h100-1
# GEMMA26_H200_NODE=    # gemma-4-26B-A4B-it/h200-1
# GEMMA26_RTX_NODE=     # gemma-4-26B-A4B-it/rtx-1
# GEMMA31_H100_NODE=    # gemma-4-31B-it/h100-1
# GEMMA31_H200_NODE=    # gemma-4-31B-it/h200-1
# GEMMA31_RTX_NODE=     # gemma-4-31B-it/rtx-1

# ENV_ROOT=/n/netscratch/<lab>/<user>/agentic-coding-llm-env
# MODELS_DIR=/n/netscratch/<lab>/<user>/models
