# Point Claude Code at Mistral Large 4 NVFP4 on one RTX node. Usage:
#   export NODE=<the node>
#   source recipes/Mistral-Large-4-1T-A52B-NVFP4/rtx-8/client.env
#   claude
_S="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$_S/../../../common/defaults.sh"
KEY_NAME=Mistral-Large-4-1T-A52B-NVFP4-rtx-8
source "$_S/../../../common/lib/api_key.sh"
_NODE="${NODE:-}"
[ -n "$_NODE" ] || echo "set NODE to the node serving mistral-large-4 before sourcing this file" >&2

export ANTHROPIC_BASE_URL="http://${_NODE}:${API_PORT:-8000}"
export ANTHROPIC_AUTH_TOKEN="$VLLM_API_KEY"
export ANTHROPIC_MODEL=mistral-large-4
export ANTHROPIC_SMALL_FAST_MODEL=mistral-large-4
export CLAUDE_CODE_MAX_CONTEXT_TOKENS=98304

export CLAUDE_CODE_ATTRIBUTION_HEADER=0
