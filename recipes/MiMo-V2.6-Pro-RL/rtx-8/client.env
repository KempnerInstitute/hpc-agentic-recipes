# Point Claude Code at MiMo-V2.6-Pro-RL on one RTX node. Usage:
#   export NODE=<the node>
#   source recipes/MiMo-V2.6-Pro-RL/rtx-8/client.env
#   claude
_S="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$_S/../../../common/defaults.sh"
KEY_NAME=MiMo-V2.6-Pro-RL-rtx-8
source "$_S/../../../common/lib/api_key.sh"
_NODE="${NODE:-}"
[ -n "$_NODE" ] || echo "set NODE to the node serving mimo-v2.6-pro before sourcing this file" >&2

export ANTHROPIC_BASE_URL="http://${_NODE}:${API_PORT:-8000}"
export ANTHROPIC_AUTH_TOKEN="$VLLM_API_KEY"
export ANTHROPIC_MODEL=mimo-v2.6-pro
export ANTHROPIC_SMALL_FAST_MODEL=mimo-v2.6-pro
export CLAUDE_CODE_MAX_CONTEXT_TOKENS=65536

export CLAUDE_CODE_ATTRIBUTION_HEADER=0
