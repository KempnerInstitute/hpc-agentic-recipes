# Point Claude Code at Hy4-preview on four H200 nodes. Usage:
#   export NODE=<the first node>
#   source recipes/Hy4-preview/h200-4-nodes4/client.env
#   claude
_S="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$_S/../../../common/defaults.sh"
KEY_NAME=Hy4-preview-h200-4-nodes4
source "$_S/../../../common/lib/api_key.sh"
_NODE="${NODE:-}"
[ -n "$_NODE" ] || echo "set NODE to the first node serving hy4-preview before sourcing this file" >&2

export ANTHROPIC_BASE_URL="http://${_NODE}:${API_PORT:-8000}"
export ANTHROPIC_AUTH_TOKEN="$VLLM_API_KEY"
export ANTHROPIC_MODEL=hy4-preview
export ANTHROPIC_DEFAULT_HAIKU_MODEL=hy4-preview
export CLAUDE_CODE_MAX_CONTEXT_TOKENS=131072
# Follow a server-side override when one is set.
[ -n "${MAX_MODEL_LEN:-}" ] && export CLAUDE_CODE_MAX_CONTEXT_TOKENS="$MAX_MODEL_LEN"

export CLAUDE_CODE_ATTRIBUTION_HEADER=0
