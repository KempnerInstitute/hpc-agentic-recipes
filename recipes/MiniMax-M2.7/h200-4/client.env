# Point Claude Code at MiniMax-M2.7 on one H200 node. Usage:
#   export NODE=<the node serving it>
#   source recipes/MiniMax-M2.7/h200-4/client.env
#   claude
_S="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$_S/../../../common/defaults.sh"
KEY_NAME=MiniMax-M2.7-h200-4
source "$_S/../../../common/lib/api_key.sh"
_NODE="${NODE:-${MINIMAX_M27_NODE:-}}"
[ -n "$_NODE" ] || echo "set NODE to the node serving minimax-m2.7 before sourcing this file" >&2

export ANTHROPIC_BASE_URL="http://${_NODE}:${API_PORT}"
export ANTHROPIC_AUTH_TOKEN="$VLLM_API_KEY"
export ANTHROPIC_MODEL=minimax-m2.7
export ANTHROPIC_DEFAULT_HAIKU_MODEL=minimax-m2.7
export CLAUDE_CODE_MAX_CONTEXT_TOKENS=196608

export CLAUDE_CODE_ATTRIBUTION_HEADER=0
