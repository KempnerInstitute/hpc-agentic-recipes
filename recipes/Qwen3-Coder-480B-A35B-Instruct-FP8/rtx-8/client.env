# Point Claude Code at Qwen3-Coder-480B-A35B-Instruct-FP8 on an RTX PRO 6000 node. Usage:
#   export NODE=<the node serving it>
#   source recipes/Qwen3-Coder-480B-A35B-Instruct-FP8/rtx-8/client.env
#   claude
_S="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$_S/../../../common/defaults.sh"
KEY_NAME=Qwen3-Coder-480B-A35B-Instruct-FP8-rtx-8
source "$_S/../../../common/lib/api_key.sh"
_NODE="${NODE:-${QWEN3_CODER_NODE:-}}"
[ -n "$_NODE" ] || echo "set NODE to the node serving qwen3-coder-480b before sourcing this file" >&2

export ANTHROPIC_BASE_URL="http://${_NODE}:${API_PORT}"
export ANTHROPIC_AUTH_TOKEN="$VLLM_API_KEY"
export ANTHROPIC_MODEL=qwen3-coder-480b
export ANTHROPIC_SMALL_FAST_MODEL=qwen3-coder-480b

export CLAUDE_CODE_ATTRIBUTION_HEADER=0

export CLAUDE_CODE_MAX_CONTEXT_TOKENS=262144
