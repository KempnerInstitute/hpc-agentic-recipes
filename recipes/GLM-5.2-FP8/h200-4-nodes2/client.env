# Point Claude Code at GLM-5.2-FP8 on two H200 nodes. Usage:
#   export NODE=<the head node>
#   source recipes/GLM-5.2-FP8/h200-4-nodes2/client.env
#   claude
_S="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$_S/../../../common/defaults.sh"
KEY_NAME=GLM-5.2-FP8-h200-4-nodes2
source "$_S/../../../common/lib/api_key.sh"
_NODE="${NODE:-${GLM52_HEAD:-}}"
[ -n "$_NODE" ] || echo "set NODE to the head node serving glm-5.2 before sourcing this file" >&2

export ANTHROPIC_BASE_URL="http://${_NODE}:${API_PORT}"
export ANTHROPIC_AUTH_TOKEN="$VLLM_API_KEY"
export ANTHROPIC_MODEL=glm-5.2
export CLAUDE_CODE_MAX_CONTEXT_TOKENS=641664
export ANTHROPIC_SMALL_FAST_MODEL=glm-5.2

export CLAUDE_CODE_ATTRIBUTION_HEADER=0
