# Point Claude Code at Muse Spark NVFP4 on one RTX node. Usage:
#   export NODE=<the serving node>
#   source recipes/Muse-Spark-Open-816B-A42B-NVFP4/rtx-8-sglang/client.env
#   claude
_S="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$_S/../../../common/defaults.sh"
KEY_NAME=Muse-Spark-Open-816B-A42B-NVFP4-rtx-8-sglang
source "$_S/../../../common/lib/api_key.sh"
_NODE="${NODE:-}"
[ -n "$_NODE" ] || echo "set NODE to the node serving muse-spark before sourcing this file" >&2

export ANTHROPIC_BASE_URL="http://${_NODE}:${API_PORT:-8000}"
export ANTHROPIC_AUTH_TOKEN="$VLLM_API_KEY"
export ANTHROPIC_MODEL=muse-spark
export CLAUDE_CODE_MAX_CONTEXT_TOKENS=262144

export CLAUDE_CODE_ATTRIBUTION_HEADER=0
