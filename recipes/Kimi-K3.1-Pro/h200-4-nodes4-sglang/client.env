# Point Claude Code at Kimi-K3.1-Pro on four H200 nodes. Usage:
#   export NODE=<the first node>
#   source recipes/Kimi-K3.1-Pro/h200-4-nodes4-sglang/client.env
#   claude
_S="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$_S/../../../common/defaults.sh"
KEY_NAME=Kimi-K3.1-Pro-h200-4-nodes4
source "$_S/../../../common/lib/api_key.sh"
_NODE="${NODE:-}"
[ -n "$_NODE" ] || echo "set NODE to the first node serving kimi-k3.1-pro before sourcing this file" >&2

export ANTHROPIC_BASE_URL="http://${_NODE}:${API_PORT:-8000}"
export ANTHROPIC_AUTH_TOKEN="$VLLM_API_KEY"
export ANTHROPIC_MODEL=kimi-k3.1-pro
export ANTHROPIC_DEFAULT_HAIKU_MODEL=kimi-k3.1-pro
export CLAUDE_CODE_MAX_CONTEXT_TOKENS="${MAX_MODEL_LEN:-262144}"

export CLAUDE_CODE_ATTRIBUTION_HEADER=0
