# Point Claude Code at Kimi-K3. Usage:
#   export NODE=<the head node serving it>
#   source recipes/Kimi-K3/h200-4-nodes4-sglang/client.env
#   claude
#
# SGLang serves an Anthropic-compatible /v1/messages alongside the OpenAI /v1, so Claude Code connects
# here with no proxy, exactly as it does to the vLLM recipes.
_S="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$_S/../../../common/defaults.sh"
source "$_S/../../../common/lib/api_key.sh"
_NODE="${NODE:-${K3_HEAD_NODE:-}}"
[ -n "$_NODE" ] || echo "set NODE to the head node serving kimi-k3 before sourcing this file" >&2

export ANTHROPIC_BASE_URL="http://${_NODE}:${API_PORT}"
# Authorization: Bearer only. ANTHROPIC_API_KEY would make the client send x-api-key, which the engine
# ignores, and every request would return 401.
export ANTHROPIC_AUTH_TOKEN="$VLLM_API_KEY"
export ANTHROPIC_MODEL=kimi-k3
# Without this the client reaches for a hosted Haiku that this endpoint does not serve.
export ANTHROPIC_SMALL_FAST_MODEL=kimi-k3

# Claude Code adds an attribution header that defeats prefix reuse here, so without this every turn of a
# conversation re-prefills the whole history. On a model this size that is the difference between a
# usable session and an unusable one.
export CLAUDE_CODE_ATTRIBUTION_HEADER=0

# Startup is long and a first request can arrive while the engine is still warming.
export API_TIMEOUT_MS=600000

# For an OpenAI-compatible client instead (Cline, Aider, Continue, OpenHands, or the openai package), use
# base URL http://<node>:8000/v1, the same key, and model name kimi-k3. See docs/clients.md.
#
# The model always emits reasoning, returned in reasoning_content rather than content. A client that reads
# only content sees an empty reply unless the budget is large enough to reach the answer. Use at least 400
# output tokens, and 800 for anything long.
