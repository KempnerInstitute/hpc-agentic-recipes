# Point an OpenAI-compatible client at Kimi-K3. Usage:
#   export NODE=<the head node serving it>
#   source recipes/Kimi-K3/h200-4-nodes4-sglang/client.env
#
# SGLang serves no Anthropic-compatible endpoint, so Claude Code cannot use this one directly and no
# ANTHROPIC_ variables are set here. Use Cline, Aider, Continue, OpenHands, or the openai package;
# see docs/clients.md.
_S="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$_S/../../../common/defaults.sh"
source "$_S/../../../common/lib/api_key.sh"
_NODE="${NODE:-${K3_HEAD_NODE:-}}"
[ -n "$_NODE" ] || echo "set NODE to the head node serving kimi-k3 before sourcing this file" >&2

export OPENAI_BASE_URL="http://${_NODE}:${API_PORT}/v1"
export OPENAI_API_KEY="$VLLM_API_KEY"
export OPENAI_MODEL=kimi-k3

# K3 always emits reasoning, and SGLang returns it in reasoning_content rather than content. A client
# that reads only content sees an empty reply unless the token budget is large enough to reach the
# answer. Use at least 400 output tokens, and 800 for anything long.
