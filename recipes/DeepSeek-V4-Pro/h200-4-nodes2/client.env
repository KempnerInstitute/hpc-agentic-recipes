# Point Claude Code at DeepSeek-V4-Pro on two H200 nodes. Usage:
#   export NODE=<the head node serving it>
#   source recipes/DeepSeek-V4-Pro/h200-4-nodes2/client.env
#   claude
_S="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$_S/../../../common/defaults.sh"
KEY_NAME=DeepSeek-V4-Pro-h200-4-nodes2
source "$_S/../../../common/lib/api_key.sh"
_NODE="${NODE:-${DSV4_H200_HEAD:-}}"
[ -n "$_NODE" ] || echo "set NODE to the head node serving deepseek-v4-pro before sourcing this file" >&2

export ANTHROPIC_BASE_URL="http://${_NODE}:${API_PORT}"
# vLLM accepts only Authorization: Bearer. ANTHROPIC_API_KEY would make the client send x-api-key,
# which vLLM ignores, and every request would return 401.
export ANTHROPIC_AUTH_TOKEN="$VLLM_API_KEY"
export ANTHROPIC_MODEL=deepseek-v4-pro
# Without this the client reaches for a hosted Haiku that this endpoint does not serve.
export ANTHROPIC_SMALL_FAST_MODEL=deepseek-v4-pro

# Drops a system block the client prepends ahead of its own, so callers on different client versions
# share one prefix cache rather than one each. See docs/quickstart.md.
export CLAUDE_CODE_ATTRIBUTION_HEADER=0
