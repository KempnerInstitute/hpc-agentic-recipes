# Point Claude Code at GLM-5.2-NVFP4 on RTX. Usage:
#   export NODE=<the node serving it>
#   source recipes/GLM-5.2-NVFP4/rtx-8/client.env
#   claude
_S="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$_S/../../../common/defaults.sh"
KEY_NAME=GLM-5.2-NVFP4-rtx-8
source "$_S/../../../common/lib/api_key.sh"
_NODE="${NODE:-${GLM52_NVFP4_NODE:-}}"
[ -n "$_NODE" ] || echo "set NODE to the node serving glm-5.2 before sourcing this file" >&2

export ANTHROPIC_BASE_URL="http://${_NODE}:${API_PORT}"
export ANTHROPIC_AUTH_TOKEN="$VLLM_API_KEY"
export ANTHROPIC_MODEL=glm-5.2
export CLAUDE_CODE_MAX_CONTEXT_TOKENS=217344
export ANTHROPIC_SMALL_FAST_MODEL=glm-5.2

export CLAUDE_CODE_ATTRIBUTION_HEADER=0
