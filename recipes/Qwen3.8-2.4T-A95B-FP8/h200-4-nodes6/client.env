# Point Claude Code at qwen3.8-2.4t on six H200 nodes. Usage:
#   export NODE=<the head node>
#   source recipes/Qwen3.8-2.4T-A95B-FP8/h200-4-nodes6/client.env
#   claude
_S="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$_S/../../../common/defaults.sh"
KEY_NAME=Qwen3.8-2.4T-A95B-FP8-h200-4-nodes6
source "$_S/../../../common/lib/api_key.sh"
_NODE="${NODE:-${QWEN38_24T_HEAD:-}}"
[ -n "$_NODE" ] || echo "set NODE to the head node serving qwen3.8-2.4t before sourcing this file" >&2

export ANTHROPIC_BASE_URL="http://${_NODE}:${API_PORT}"
export ANTHROPIC_AUTH_TOKEN="$VLLM_API_KEY"
export ANTHROPIC_MODEL=qwen3.8-2.4t
export CLAUDE_CODE_MAX_CONTEXT_TOKENS=262144
export ANTHROPIC_DEFAULT_HAIKU_MODEL=qwen3.8-2.4t

export CLAUDE_CODE_ATTRIBUTION_HEADER=0
