# Point Claude Code at DeepSeek-V4-Flash-0731 on one RTX node. Usage:
#   export NODE=<the node serving it>
#   source recipes/DeepSeek-V4-Flash-0731/rtx-8/client.env
#   claude
_S="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$_S/../../../common/defaults.sh"
KEY_NAME=DeepSeek-V4-Flash-0731-rtx-8
source "$_S/../../../common/lib/api_key.sh"
_NODE="${NODE:-${DSV4_FLASH_NODE:-}}"
[ -n "$_NODE" ] || echo "set NODE to the node serving deepseek-v4-flash before sourcing this file" >&2

export ANTHROPIC_BASE_URL="http://${_NODE}:${API_PORT}"
export ANTHROPIC_AUTH_TOKEN="$VLLM_API_KEY"
export ANTHROPIC_MODEL=deepseek-v4-flash
export CLAUDE_CODE_MAX_CONTEXT_TOKENS=1048576
export ANTHROPIC_SMALL_FAST_MODEL=deepseek-v4-flash

export CLAUDE_CODE_ATTRIBUTION_HEADER=0
