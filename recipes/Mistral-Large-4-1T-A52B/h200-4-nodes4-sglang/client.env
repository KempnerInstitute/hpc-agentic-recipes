# Point Claude Code at Mistral Large 4 FP8 on four H200 nodes. Usage:
#   export NODE=<the first node>
#   source recipes/Mistral-Large-4-1T-A52B/h200-4-nodes4-sglang/client.env
#   claude
_S="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$_S/../../../common/defaults.sh"
KEY_NAME=Mistral-Large-4-1T-A52B-h200-4-nodes4
source "$_S/../../../common/lib/api_key.sh"
_NODE="${NODE:-}"
[ -n "$_NODE" ] || echo "set NODE to the first node serving mistral-large-4 before sourcing this file" >&2

export ANTHROPIC_BASE_URL="http://${_NODE}:${API_PORT:-8000}"
export ANTHROPIC_AUTH_TOKEN="$VLLM_API_KEY"
export ANTHROPIC_MODEL=mistral-large-4
export ANTHROPIC_SMALL_FAST_MODEL=mistral-large-4
export CLAUDE_CODE_MAX_CONTEXT_TOKENS=262144

export CLAUDE_CODE_ATTRIBUTION_HEADER=0
