# Point Claude Code at qwen3.8-27b-fp8 on one H200 GPU. Usage:
#   export NODE=<the node serving it>
#   source recipes/Qwen3.8-27B-FP8/h200-1/client.env
#   claude
_S="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$_S/../../../common/defaults.sh"
KEY_NAME=Qwen3.8-27B-FP8-h200-1
source "$_S/../../../common/lib/api_key.sh"
_NODE="${NODE:-${QWEN38_27B_FP8_NODE:-}}"
[ -n "$_NODE" ] || echo "set NODE to the node serving qwen3.8-27b-fp8 before sourcing this file" >&2

export ANTHROPIC_BASE_URL="http://${_NODE}:${API_PORT}"
export ANTHROPIC_AUTH_TOKEN="$VLLM_API_KEY"
export ANTHROPIC_MODEL=qwen3.8-27b-fp8
export ANTHROPIC_SMALL_FAST_MODEL=qwen3.8-27b-fp8

export CLAUDE_CODE_ATTRIBUTION_HEADER=0
export CLAUDE_CODE_MAX_CONTEXT_TOKENS=262144

