# Point Claude Code at Kimi-K2.7-Code on two H200 nodes. Usage:
#   export NODE=<the head node serving it>
#   source recipes/Kimi-K2.7-Code/h200-4-nodes2/client.env
#   claude
# The endpoint lives on the Ray head only. The worker node serves nothing and answers nothing.
_S="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$_S/../../../common/defaults.sh"
KEY_NAME=Kimi-K2.7-Code-h200-4-nodes2
source "$_S/../../../common/lib/api_key.sh"
_NODE="${NODE:-${KIMI_HEAD:-}}"
[ -n "$_NODE" ] || echo "set NODE to the head node serving kimi-k2.7-code before sourcing this file" >&2

export ANTHROPIC_BASE_URL="http://${_NODE}:${API_PORT}"
# vLLM accepts only Authorization: Bearer. ANTHROPIC_API_KEY would make the client send x-api-key,
# which vLLM ignores, and every request would return 401.
export ANTHROPIC_AUTH_TOKEN="$VLLM_API_KEY"
export ANTHROPIC_MODEL=kimi-k2.7-code
# Without this the client reaches for a hosted Haiku that this endpoint does not serve.
export ANTHROPIC_SMALL_FAST_MODEL=kimi-k2.7-code

# Drops a system block the client prepends ahead of its own, so callers on different client versions
# share one prefix cache rather than one each. See docs/quickstart.md.
export CLAUDE_CODE_ATTRIBUTION_HEADER=0

# Claude Code asks for 32000 output tokens by default, and its own system prompt and tool
# definitions are about 24K tokens, which together exceed this endpoint's context. Without this
# cap every request fails with a maximum context length error before the model sees anything.
export CLAUDE_CODE_MAX_OUTPUT_TOKENS=4096
