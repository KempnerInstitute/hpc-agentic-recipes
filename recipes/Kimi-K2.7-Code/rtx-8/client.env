# Point Claude Code at Kimi-K2.7-Code on RTX. Usage:
#   export NODE=<the node serving it>
#   source recipes/Kimi-K2.7-Code/rtx-8/client.env
#   claude
_S="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$_S/../../../common/defaults.sh"
KEY_NAME=Kimi-K2.7-Code-rtx-8
source "$_S/../../../common/lib/api_key.sh"
_NODE="${NODE:-${KIMI_RTX_NODE:-}}"
[ -n "$_NODE" ] || echo "set NODE to the node serving kimi-k2.7-code before sourcing this file" >&2

export ANTHROPIC_BASE_URL="http://${_NODE}:${API_PORT}"
export ANTHROPIC_AUTH_TOKEN="$VLLM_API_KEY"
export ANTHROPIC_MODEL=kimi-k2.7-code
export CLAUDE_CODE_MAX_CONTEXT_TOKENS=131072
export ANTHROPIC_SMALL_FAST_MODEL=kimi-k2.7-code

export CLAUDE_CODE_ATTRIBUTION_HEADER=0
