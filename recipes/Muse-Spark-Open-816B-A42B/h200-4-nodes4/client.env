# Point Claude Code at Muse-Spark-Open-816B-A42B on two H200 nodes. Usage:
#   export NODE=<the head node>
#   source recipes/Muse-Spark-Open-816B-A42B/h200-4-nodes4/client.env
#   claude
_S="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$_S/../../../common/defaults.sh"
KEY_NAME=Muse-Spark-Open-816B-A42B-h200-4-nodes4
source "$_S/../../../common/lib/api_key.sh"
_NODE="${NODE:-${MUSE_HEAD:-}}"
[ -n "$_NODE" ] || echo "set NODE to the head node serving muse-spark before sourcing this file" >&2

export ANTHROPIC_BASE_URL="http://${_NODE}:${API_PORT}"
export ANTHROPIC_AUTH_TOKEN="$VLLM_API_KEY"
export ANTHROPIC_MODEL=muse-spark
export CLAUDE_CODE_MAX_CONTEXT_TOKENS=262144
export ANTHROPIC_DEFAULT_HAIKU_MODEL=muse-spark

export CLAUDE_CODE_ATTRIBUTION_HEADER=0
