# Point Claude Code at Muse Glimmer 30B on one H200 GPU. Usage:
#   export NODE=<the node>
#   source recipes/Muse-Glimmer-30B/h200-1/client.env
#   claude
_S="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$_S/../../../common/defaults.sh"
KEY_NAME=Muse-Glimmer-30B-h200-1
source "$_S/../../../common/lib/api_key.sh"
_NODE="${NODE:-}"
[ -n "$_NODE" ] || echo "set NODE to the node serving muse-glimmer before sourcing this file" >&2

export ANTHROPIC_BASE_URL="http://${_NODE}:${API_PORT:-8000}"
export ANTHROPIC_AUTH_TOKEN="$VLLM_API_KEY"
export ANTHROPIC_MODEL=muse-glimmer
export ANTHROPIC_DEFAULT_HAIKU_MODEL=muse-glimmer
export CLAUDE_CODE_MAX_CONTEXT_TOKENS=131072

export CLAUDE_CODE_ATTRIBUTION_HEADER=0
