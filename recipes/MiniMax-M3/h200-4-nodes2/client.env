# Point Claude Code at MiniMax-M3 on two H200 nodes. Usage:
#   export NODE=<the head node>
#   source recipes/MiniMax-M3/h200-4-nodes2/client.env
#   claude
_S="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$_S/../../../common/defaults.sh"
KEY_NAME=MiniMax-M3-h200-4-nodes2
source "$_S/../../../common/lib/api_key.sh"
_NODE="${NODE:-${MINIMAX_M3_HEAD:-}}"
[ -n "$_NODE" ] || echo "set NODE to the head node serving minimax-m3 before sourcing this file" >&2

export ANTHROPIC_BASE_URL="http://${_NODE}:${API_PORT}"
export ANTHROPIC_AUTH_TOKEN="$VLLM_API_KEY"
export ANTHROPIC_MODEL=minimax-m3
export CLAUDE_CODE_MAX_CONTEXT_TOKENS=131072
export ANTHROPIC_DEFAULT_HAIKU_MODEL=minimax-m3

export CLAUDE_CODE_ATTRIBUTION_HEADER=0
