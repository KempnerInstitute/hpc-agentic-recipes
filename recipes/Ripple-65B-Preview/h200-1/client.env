# Point Claude Code at Ripple-65B-Preview on one H200 GPU. Usage:
#   export NODE=<the node>
#   source recipes/Ripple-65B-Preview/h200-1/client.env
#   claude
_S="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$_S/../../../common/defaults.sh"
KEY_NAME=Ripple-65B-Preview-h200-1
source "$_S/../../../common/lib/api_key.sh"
_NODE="${NODE:-}"
[ -n "$_NODE" ] || echo "set NODE to the node serving ripple before sourcing this file" >&2

export ANTHROPIC_BASE_URL="http://${_NODE}:${API_PORT:-8000}"
export ANTHROPIC_AUTH_TOKEN="$VLLM_API_KEY"
export ANTHROPIC_MODEL=ripple
export ANTHROPIC_DEFAULT_HAIKU_MODEL=ripple
export CLAUDE_CODE_MAX_CONTEXT_TOKENS=32768

export CLAUDE_CODE_ATTRIBUTION_HEADER=0
